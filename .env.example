# DisasterShield Environment Configuration
# ==============================================================
# Google Maps API Key
# 1. Get your key at: https://console.cloud.google.com/google/maps-apis
# 2. Enable "Maps JavaScript API"
# 3. Paste key below, or configure directly inside the app using the "API Key: Configure" button
VITE_GOOGLE_MAPS_API_KEY=

# Backend API Base URL (Node.js REST server running on port 5001)
VITE_API_BASE_URL=http://localhost:5001/api
